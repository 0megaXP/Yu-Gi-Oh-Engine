+// ygoe: counts down interpreter::script_budget every 100000 instructions; past it, the script
+// is stopped with an error (the rules core treats it like any script error: the check fails).
+static void ygoe_budget_hook(lua_State* L, lua_Debug*) {
+	duel* pd;
+	std::memcpy(&pd, lua_getextraspace(L), sizeof(duel*));
+	auto* lua = pd->lua;
+	if(!lua || (lua->script_budget -= 100000) > 0)
+		return;
+	if(!lua->budget_reported) {
+		lua->budget_reported = true;
+		luaL_traceback(L, L, "a card script ran too long and was stopped (its check counts as failed)", 1);
+		pd->handle_message(lua_tostring(L, -1), OCG_LOG_TYPE_ERROR);
+		lua_pop(L, 1);
+	}
+	luaL_error(L, "script ran too long");
+}
+
