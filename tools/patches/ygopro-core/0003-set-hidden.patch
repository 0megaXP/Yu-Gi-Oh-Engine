+void OCG_DuelSetHidden(OCG_Duel ocg_duel, uint8_t team, const uint32_t* hand, uint32_t count, const uint32_t* deck,
+                       uint32_t deck_count, uint64_t seed) {
+	auto* pduel = static_cast<duel*>(ocg_duel);
+	if(!pduel || team > 1)
+		return;
+	auto& field = *pduel->game_field;
+	auto& pl = field.player[team];
+	// a card taken out of play: out of every list, its effects off (it stays owned by the duel)
+	auto retire = [](card* c) {
+		c->enable_field_effect(false);
+		c->current.location = 0;
+	};
+	auto fresh = [&](uint32_t code, uint8_t location) {
+		card* c = pduel->new_card(code);
+		c->owner = team;
+		c->current.controler = team;
+		c->current.location = location;
+		c->current.position = POS_FACEDOWN_DEFENSE;
+		return c;
+	};
+	for(uint32_t i = 0; hand && i < count && i < pl.list_hand.size(); ++i) {
+		card* h = pl.list_hand[i];
+		if(!hand[i] || h->data.code == hand[i])
+			continue;
+		if(deck) {
+			// a guessed Deck: the card is made anew
+			card* c = fresh(hand[i], LOCATION_HAND);
+			c->current.position = h->current.position;
+			retire(h);
+			pl.list_hand[i] = c;
+			c->enable_field_effect(true);
+			continue;
+		}
+		for(auto& slot : pl.list_main) {
+			card* c = slot;
+			if(c->data.code != hand[i])
+				continue;
+			h->enable_field_effect(false);
+			c->enable_field_effect(false);
+			std::swap(h->current, c->current);
+			pl.list_hand[i] = c;
+			slot = h;
+			h->enable_field_effect(true);
+			c->enable_field_effect(true);
+			break;
+		}
+	}
+	if(deck) {
+		for(card* c : pl.list_main)
+			retire(c);
+		pl.list_main.clear();
+		for(uint32_t i = 0; i < deck_count; ++i) {
+			card* c = fresh(deck[i], LOCATION_DECK);
+			pl.list_main.push_back(c);
+			c->enable_field_effect(true);
+		}
+	}
+	if(seed) {
+		std::mt19937_64 rng(seed);
+		std::shuffle(pl.list_main.begin(), pl.list_main.end(), rng);
+	}
+	field.reset_sequence(team, LOCATION_DECK);
+	field.reset_sequence(team, LOCATION_HAND);
+}
