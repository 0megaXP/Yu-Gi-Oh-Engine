+void OCG_DuelSetHidden(OCG_Duel ocg_duel, uint8_t team, const uint32_t* hand, uint32_t count, uint64_t seed) {
+	auto* pduel = static_cast<duel*>(ocg_duel);
+	if(!pduel || team > 1)
+		return;
+	auto& pl = pduel->game_field->player[team];
+	for(uint32_t i = 0; hand && i < count && i < pl.list_hand.size(); ++i) {
+		card* h = pl.list_hand[i];
+		if(!hand[i] || h->data.code == hand[i])
+			continue;
+		for(auto& slot : pl.list_main) {
+			card* c = slot;
+			if(c->data.code != hand[i])
+				continue;
+			h->enable_field_effect(false);
+			c->enable_field_effect(false);
+			std::swap(h->current, c->current);
+			pl.list_hand[i] = c;
+			slot = h;
+			h->enable_field_effect(true);
+			c->enable_field_effect(true);
+			break;
+		}
+	}
+	if(seed) {
+		std::mt19937_64 rng(seed);
+		std::shuffle(pl.list_main.begin(), pl.list_main.end(), rng);
+	}
+	pduel->game_field->reset_sequence(team, LOCATION_DECK);
+	pduel->game_field->reset_sequence(team, LOCATION_HAND);
+}
