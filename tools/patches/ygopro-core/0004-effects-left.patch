 }
+
+uint32_t OCG_DuelEffectsLeft(OCG_Duel ocg_duel, uint8_t team, uint8_t location, uint32_t sequence) {
+	auto* pduel = static_cast<duel*>(ocg_duel);
+	if(!pduel || team > 1)
+		return 0;
+	auto& pl = pduel->game_field->player[team];
+	card* pcard = nullptr;
+	if(location == LOCATION_HAND) {
+		if(sequence < pl.list_hand.size())
+			pcard = pl.list_hand[sequence];
+	} else if(location == LOCATION_GRAVE) {
+		if(sequence < pl.list_grave.size())
+			pcard = pl.list_grave[sequence];
+	} else {
+		pcard = pduel->game_field->get_field_card(team, location, sequence);
+	}
+	if(!pcard)
+		return 0;
+	uint32_t limited = 0, left = 0;
+	for(const auto& entry : pcard->indexer) {
+		const effect* peffect = entry.first;
+		if(!(peffect->type & EFFECT_TYPE_ACTIONS) || !peffect->has_count_limit())
+			continue;
+		++limited;
+		if(peffect->check_count_limit(team))
+			++left;
+	}
+	return std::min<uint32_t>(limited, 0xffff) | std::min<uint32_t>(left, 0xffff) << 16;
+}
