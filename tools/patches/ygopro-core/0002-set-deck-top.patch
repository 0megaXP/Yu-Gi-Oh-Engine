 		*length = static_cast<uint32_t>(query.size());
 	return query.data();
 }
+
+void OCG_DuelSetDeckTop(OCG_Duel ocg_duel, uint8_t team, const uint32_t* codes, uint32_t count) {
+	auto* pduel = static_cast<duel*>(ocg_duel);
+	if(!pduel || team > 1 || !codes)
+		return;
+	auto& deck = pduel->game_field->player[team].list_main;
+	size_t placed = 0;  // cards already put on top (the back of the list)
+	for(uint32_t k = 0; k < count; ++k) {
+		const size_t limit = deck.size() - placed;
+		for(size_t i = limit; i-- > 0;) {
+			card* c = deck[i];
+			if(c->data.code == codes[k] || (c->data.alias && c->data.alias == codes[k])) {
+				deck.erase(deck.begin() + static_cast<std::ptrdiff_t>(i));
+				deck.insert(deck.end() - static_cast<std::ptrdiff_t>(placed), c);
+				// each one goes under the ones placed before it: codes[0] stays on top
+				++placed;
+				break;
+			}
+		}
+	}
+	pduel->game_field->reset_sequence(team, LOCATION_DECK);
+}
